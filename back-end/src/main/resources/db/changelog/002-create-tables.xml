    <!-- =========================================================== -->
    <!--  13. Vistas (missing_stickers)                              -->
    <!-- =========================================================== -->
    <changeSet id="13" author="migration">
        <createView viewName="missing_stickers">
            SELECT
            a.id   AS album_id,
            s.id   AS sticker_id,
            s.code AS sticker_code,
            s.name AS sticker_name,
            s.rarity,
            s.sticker_type
            FROM albums a
            CROSS JOIN stickers s
            WHERE s.deleted_at IS NULL
            AND NOT EXISTS (
            SELECT 1 FROM album_stickers als
            WHERE als.album_id = a.id AND als.sticker_id = s.id
            )
        </createView>
        <rollback>
            <dropView viewName="missing_stickers"/>
        </rollback>
    </changeSet>

