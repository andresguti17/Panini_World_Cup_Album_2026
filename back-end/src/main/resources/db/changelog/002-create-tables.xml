            ALTER TABLE stickers ADD CONSTRAINT chk_sticker_player CHECK (sticker_type <> 'player' OR player_id IS NOT NULL);
            ALTER TABLE stickers ADD CONSTRAINT chk_sticker_team CHECK (sticker_type <> 'team' OR team_id IS NOT NULL);
            ]]>
